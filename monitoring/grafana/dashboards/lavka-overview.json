{
  "id": null,
  "uid": "lavka-overview",
  "title": "Lavka — Microservices & Host Metrics",
  "tags": ["lavka", "microservices", "grpc", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Gateway — HTTP Hits (rate)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, path, status) (rate(lavka_http_requests_total[1m]))",
          "legendFormat": "{{method}} {{path}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Gateway — HTTP Errors (4xx/5xx)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (method, path, status) (rate(lavka_http_errors_total[1m]))",
          "legendFormat": "{{method}} {{path}} [{{status}}]"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Gateway — Avg HTTP Latency (s)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(lavka_http_request_duration_seconds_sum[1m]) / clamp_min(rate(lavka_http_request_duration_seconds_count[1m]), 0.0001)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC Services (Auth + Catalog) — Hits",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, method, code) (rate(lavka_grpc_requests_total[1m]))",
          "legendFormat": "{{service}} {{method}} [{{code}}]"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "gRPC Services (Auth + Catalog) — Errors",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (service, method, code) (rate(lavka_grpc_errors_total[1m]))",
          "legendFormat": "{{service}} {{method}} [{{code}}]"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "gRPC Services — Avg Latency (s)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(lavka_grpc_request_duration_seconds_sum[1m]) / clamp_min(rate(lavka_grpc_request_duration_seconds_count[1m]), 0.0001)",
          "legendFormat": "{{service}} {{method}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host CPU Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host Memory Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "RAM %"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Host Disk Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "legendFormat": "Disk / %"
        }
      ]
    }
  ]
}
